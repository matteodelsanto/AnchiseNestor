# Experiment notes
/EXPERIMENTS_*.md
/FOLDS.md

# Run outputs
/logs/
/plots/
*.out

# Experiment scripts not tracked
/src/run_coherence_roberta/

# runnestoranchise: keep only the experiment scripts and walk orders
/src/runnestoranchise/*
!/src/runnestoranchise/run_experiment.py
!/src/runnestoranchise/run_experiment_fold.py
!/src/runnestoranchise/run_experiment_optimized.py
!/src/runnestoranchise/fold_walk_order.json
!/src/runnestoranchise/walk_order.json

# run_ppl_coherence: keep folds and balanced only
/src/run_ppl_coherence/ppl_coherence.py
/src/run_ppl_coherence/ppl_coherence_folds_base.py

# Keep data directories, but ignore their contents
/resources/data/input/*
!/resources/data/input/.gitkeep
/resources/data/output/*
!/resources/data/output/.gitkeep
/resources/data/output_gpt2/*
!/resources/data/output_gpt2/.gitkeep
/resources/data/results/*
!/resources/data/results/.gitkeep

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# Virtual environments
.venv/
venv/
env/
.env/
.tox/
.nox/

# Build and packaging artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/

# Test coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Notebooks and local environment variables
.ipynb_checkpoints/
.env
.env.*
!.env.example

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
